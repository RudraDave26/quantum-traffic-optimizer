# ==============================================================================
# Q-ROUTE: Quantum-Inspired Intelligent Traffic Route Optimization System
# Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Paste your secret API keys in '.env' (do NOT commit .env to git!)
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Optional: Google Maps / Google Routes API Key (Leave blank to use free OSRM + OSM)
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=

# SQLite Database Location (Auto-created if omitted)
DATABASE_URL=file:./data/qroute_db.json

# Traffic Update Polling Interval (in milliseconds, default: 10000ms = 10s)
TRAFFIC_POLL_INTERVAL_MS=10000

# Environment Mode: development / production
NODE_ENV=development

# Groq Cloud Ultra-Fast AI Engine (Add your Groq API Key here)
# Supports multi-key failover pool: GROQ_API_KEYS=key1,key2,key3
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_TERTIARY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
